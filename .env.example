# Copy to .env and fill in.  .env is gitignored — never commit real values.

# --- WhatsApp Cloud API (see scripts/meta_setup.md) ---
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
# App Dashboard -> Settings -> Basic. WA_APP_ID is only needed by scripts/wa_webhook.py,
# which configures the webhook over the API instead of the dashboard.
WA_APP_ID=
# "WhatsApp Business Account ID" on the API Setup page — NOT the phone number ID.
# Needed to verify /{waba-id}/subscribed_apps; without that subscription the webhook
# verifies successfully and then silently never delivers anything.
WA_WABA_ID=
# Required: the app refuses to start without it (it signs every webhook POST).
WA_APP_SECRET=
WA_VERIFY_TOKEN=change-me-to-any-random-string
# Required: the app refuses to start with an empty list.
# One entry per person allowed to log, comma-separated. Max 5 on the test number.
# Format: country code + number, NO '+', NO spaces/dashes, and drop the national trunk '0'.
#   UK 07700 900123  ->  447700900123      (not 4407700900123)
#   IN 098765 43210   ->  919876543210
# Must match Meta's recipient list exactly (meta_setup.md step 3), or messages are dropped.
#   e.g. ALLOWED_WA_IDS=447700900123,447700900456
ALLOWED_WA_IDS=
# Optional, only makes /today readable later. id:Name pairs, comma-separated.
#   e.g. WA_DISPLAY_NAMES=447700900123:Jeevan,447700900456:Sam
WA_DISPLAY_NAMES=

# --- Huckleberry ---
HUCKLEBERRY_EMAIL=
HUCKLEBERRY_PASSWORD=
HUCKLEBERRY_CHILD_UID=

# --- LLM ---
LLM_PROVIDER=nvidia
NVIDIA_API_KEY=
# Nemotron reasons by default; the provider sends /no_think to disable it for the parser.
NVIDIA_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1.5
NVIDIA_REASONING=false
# Only used if LLM_PROVIDER=anthropic (install with: uv sync --extra anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# --- General ---
LOCAL_TZ=Europe/London
# Local dev uses ./journal.db; the Docker/Oracle deploy overrides this to /data/journal.db
# (a persistent volume) via docker-compose.yml, so leave this as-is.
DB_PATH=./journal.db

# --- Deploy (Oracle Always Free VM — only needed on the server, see deploy/oracle-setup.md) ---
# Your free DuckDNS hostname and token (https://www.duckdns.org).
SITE_ADDRESS=myhuck.duckdns.org
DUCKDNS_SUBDOMAIN=myhuck
DUCKDNS_TOKEN=
